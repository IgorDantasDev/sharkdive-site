---
import { Binoculars, GraduationCap, WavesLadder } from "@lucide/astro";
import { quickLinksCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { selectCopy } from "../lib/i18n";
import { withBase } from "../lib/path";
import { sectionPath } from "../lib/routes";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = selectCopy(lang, quickLinksCopy);
---

<section class="quick-links" id="acessos" aria-label={copy.label}>
  <div class="shell quick-grid">
    <a href={withBase(sectionPath(lang, "batismo"))}>
      <WavesLadder size={22} />
      <span class="quick-label-full">{copy.firstDive}</span>
      <span class="quick-label-mobile">{copy.firstDiveShort}</span>
    </a>
    <a href={withBase(sectionPath(lang, "cursos"))}>
      <GraduationCap size={22} />
      <span class="quick-label-full">{copy.courses}</span>
      <span class="quick-label-mobile">{copy.courses}</span>
    </a>
    <a href={withBase(sectionPath(lang, "baleias"))}>
      <Binoculars size={22} />
      <span class="quick-label-full">{copy.whaleSafari}</span>
      <span class="quick-label-mobile">{copy.whales}</span>
    </a>
  </div>
</section>

<style>
  .quick-links {
    border-bottom: 1px solid rgb(255 255 255 / 18%);
    background: var(--abyss);
    color: white;
    --focus: var(--focus-on-dark);
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .quick-grid a {
    display: flex;
    min-height: 92px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-right: 1px solid rgb(255 255 255 / 18%);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }

  .quick-grid a:first-child {
    border-left: 1px solid rgb(255 255 255 / 18%);
  }

  .quick-grid svg {
    color: var(--accent-on-dark-bright);
  }

  .quick-grid a:hover {
    background: var(--ocean-hover);
  }

  .quick-label-mobile {
    display: none;
  }

  @media (max-width: 940px) {
    .quick-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .quick-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .quick-grid a {
      min-width: 0;
      min-height: 78px;
      flex-direction: column;
      border-bottom: 1px solid rgb(255 255 255 / 18%);
      padding: 12px 8px;
      font-size: 0.72rem;
      line-height: 1.35;
    }

    .quick-label-full {
      display: none;
    }

    .quick-label-mobile {
      display: inline;
    }
  }
</style>
