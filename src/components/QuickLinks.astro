---
import { Binoculars, GraduationCap, WavesLadder } from "@lucide/astro";
import type { Locale } from "../lib/i18n";
import { translate } from "../lib/i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = (pt: string, en: string) => translate(lang, pt, en);
---

<section class="quick-links" id="acessos" aria-label={t("Acessos rápidos", "Quick links")}>
  <div class="shell quick-grid">
    <a href="#mergulho-recreativo">
      <WavesLadder size={22} />
      <span class="quick-label-full">{t("Batismo de mergulho", "Discover scuba diving")}</span>
      <span class="quick-label-mobile">{t("Batismo", "First dive")}</span>
    </a>
    <a href="#cursos">
      <GraduationCap size={22} />
      <span class="quick-label-full">{t("Cursos", "Courses")}</span>
      <span class="quick-label-mobile">{t("Cursos", "Courses")}</span>
    </a>
    <a href="#safari-baleias">
      <Binoculars size={22} />
      <span class="quick-label-full">{t("Safari de baleias", "Whale-watching safari")}</span>
      <span class="quick-label-mobile">{t("Baleias", "Whales")}</span>
    </a>
  </div>
</section>

<style>
  .quick-links {
    border-bottom: 1px solid rgb(255 255 255 / 18%);
    background: var(--abyss);
    color: white;
    --focus: var(--focus-on-dark);
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .quick-grid a {
    display: flex;
    min-height: 92px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-right: 1px solid rgb(255 255 255 / 18%);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }

  .quick-grid a:first-child {
    border-left: 1px solid rgb(255 255 255 / 18%);
  }

  .quick-grid svg {
    color: var(--accent-on-dark-bright);
  }

  .quick-grid a:hover {
    background: var(--ocean-hover);
  }

  .quick-label-mobile {
    display: none;
  }

  @media (max-width: 940px) {
    .quick-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .quick-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .quick-grid a {
      min-width: 0;
      min-height: 78px;
      flex-direction: column;
      border-bottom: 1px solid rgb(255 255 255 / 18%);
      padding: 12px 8px;
      font-size: 0.72rem;
      line-height: 1.35;
    }

    .quick-label-full {
      display: none;
    }

    .quick-label-mobile {
      display: inline;
    }
  }
</style>
