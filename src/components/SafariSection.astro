---
import { Picture } from "astro:assets";
import { ArrowRight, Binoculars, CalendarDays, MapPin, Users } from "@lucide/astro";
import baleiaSalto from "../assets/acervo/baleia-salto.jpg";
import { safariCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { selectCopy } from "../lib/i18n";
import { whatsappUrl } from "../lib/contact";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = selectCopy(lang, safariCopy);
---

<section class="section secondary safari" id="safari-baleias">
  <div class="shell">
    <figure class="safari-media">
      <div class="media-crop media-crop-whale">
        <Picture
          src={baleiaSalto}
          formats={["avif", "webp"]}
          fallbackFormat="jpeg"
          widths={[640, 1024, 1440, 1800]}
          sizes="(max-width: 1180px) 100vw, 1180px"
          alt={copy.imageAlt}
          loading="lazy"
        />
      </div>
      <figcaption>{copy.caption}</figcaption>
    </figure>

    <div class="safari-layout">
    <div class="section-heading">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
    </div>

    <div class="safari-content">
      <Binoculars class="safari-icon" size={36} />
      <p class="safari-lead">{copy.lead}</p>

      <div class="safari-details">
        <span><CalendarDays size={19} /> {copy.season}</span>
        <span><MapPin size={19} /> {copy.departure}</span>
        <span><Users size={19} /> {copy.booking}</span>
      </div>

      <a
        class="button button-primary"
        href={whatsappUrl(copy.message)}
        target="_blank"
        rel="noreferrer"
      >
        {copy.cta}
        <ArrowRight size={18} />
      </a>
    </div>
    </div>
  </div>
</section>

<style>
  .secondary {
    background: var(--secondary-bg);
    color: white;
    --focus: var(--focus-on-dark);
  }

  .secondary .eyebrow {
    color: var(--accent-on-dark);
  }

  .safari-layout {
    display: grid;
    grid-template-columns: 1fr minmax(380px, 0.8fr);
    gap: 100px;
    margin-top: 72px;
  }

  .safari-media {
    margin: 0;
  }

  .media-crop-whale {
    aspect-ratio: 16 / 7;
  }

  .media-crop-whale img {
    object-position: center 50%;
  }

  /* .section-media figcaption (global) não alcança .safari-media — regra completa aqui. */
  .safari-media figcaption {
    margin-top: 10px;
    color: var(--text-on-dark-muted);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .safari .section-heading h2 {
    margin-bottom: 0;
  }

  .safari-content {
    display: grid;
    align-content: start;
    border-top: 1px solid rgb(255 255 255 / 28%);
    padding-top: 30px;
  }

  .safari-icon {
    margin-bottom: 30px;
    color: var(--accent-on-dark);
  }

  .safari-lead {
    margin-bottom: 30px;
    color: var(--text-on-dark);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .safari-details {
    display: grid;
    border-bottom: 1px solid rgb(255 255 255 / 28%);
  }

  .safari-details span {
    display: grid;
    grid-template-columns: 24px 1fr;
    align-items: center;
    gap: 12px;
    border-top: 1px solid rgb(255 255 255 / 18%);
    padding-block: 14px;
    color: var(--text-on-dark);
    font-size: 0.84rem;
    font-weight: 700;
  }

  .safari .button {
    justify-self: start;
    margin-top: 30px;
  }

  @media (max-width: 940px) {
    .safari-layout {
      grid-template-columns: 1fr;
      gap: 42px;
    }
  }

  @media (max-width: 640px) {
    .media-crop-whale {
      aspect-ratio: 4 / 3;
    }

    .safari-layout {
      gap: 32px;
      margin-top: 40px;
    }
  }
</style>
