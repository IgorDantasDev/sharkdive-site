---
import { Check, Languages, Menu, Moon, Sun, X } from "@lucide/astro";
import { siWhatsapp } from "simple-icons";
import { headerCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { localeSettings, selectCopy } from "../lib/i18n";
import { whatsappUrl } from "../lib/contact";
import { withBase } from "../lib/path";
import { sectionPath, type SectionRoute } from "../lib/routes";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  lang: Locale;
  currentSection?: SectionRoute;
}

const { lang, currentSection } = Astro.props;
const copy = selectCopy(lang, headerCopy);
const sectionHref = (section: SectionRoute) => withBase(sectionPath(lang, section));
const languages = [
  { code: "pt", label: "Português", root: "/" },
  { code: "en", label: "English", root: "/en/" },
  { code: "es", label: "Español", root: "/es/" },
] as const;
const languageHref = (locale: Locale, root: string) => withBase(
  currentSection ? sectionPath(locale, currentSection) : root,
);
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href={sectionHref("inicio")} aria-label={copy.brandLabel}>
      <img
        src={withBase("/images/brand/sharkdive-logo-white.png")}
        width="1999"
        height="787"
        alt={copy.brandAlt}
      />
    </a>

    <nav class="desktop-nav" aria-label={copy.mainNavigation}>
      <a href={sectionHref("batismo")} aria-current={currentSection === "batismo" ? "page" : undefined}>{copy.diving}</a>
      <a href={sectionHref("cursos")} aria-current={currentSection === "cursos" ? "page" : undefined}>{copy.courses}</a>
      <a href={sectionHref("baleias")} aria-current={currentSection === "baleias" ? "page" : undefined}>{copy.whales}</a>
      <a href={sectionHref("sobre")} aria-current={currentSection === "sobre" ? "page" : undefined}>{copy.about}</a>
    </nav>

    <div class="header-actions">
      <details class="language-menu" data-language-menu>
        <summary
          class="utility-button language-switch"
          aria-label={copy.selectLanguage}
          title={copy.language}
        >
          <Languages size={18} />
          <span>{lang.toUpperCase()}</span>
        </summary>
        <div class="language-options">
          {languages.map((language) => (
            <a
              href={languageHref(language.code, language.root)}
              lang={localeSettings[language.code].htmlLang}
              aria-current={language.code === lang ? "page" : undefined}
            >
              <span>{language.label}</span>
              {language.code === lang && <Check size={16} />}
            </a>
          ))}
        </div>
      </details>

      <button
        class="utility-button theme-toggle"
        type="button"
        aria-label={copy.enableDark}
        title={copy.switchTheme}
        data-theme-toggle
        data-dark-label={copy.enableDark}
        data-light-label={copy.enableLight}
      >
        <Moon class="theme-moon" size={19} />
        <Sun class="theme-sun" size={19} />
      </button>

      <a
        class="button button-primary header-cta"
        href={whatsappUrl(copy.contactMessage)}
        target="_blank"
        rel="noreferrer"
      >
        <BrandIcon path={siWhatsapp.path} size={18} />
        {copy.contactUs}
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-label={copy.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-open-label={copy.openMenu}
        data-close-label={copy.closeMenu}
      >
        <Menu class="menu-open-icon" size={24} />
        <X class="menu-close-icon" size={24} />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-menu" aria-label={copy.mobileNavigation} data-mobile-menu>
    <a href={sectionHref("batismo")} aria-current={currentSection === "batismo" ? "page" : undefined}>{copy.recreationalDiving}</a>
    <a href={sectionHref("cursos")} aria-current={currentSection === "cursos" ? "page" : undefined}>{copy.courses}</a>
    <a href={sectionHref("baleias")} aria-current={currentSection === "baleias" ? "page" : undefined}>{copy.whaleSafari}</a>
    <a href={sectionHref("sobre")} aria-current={currentSection === "sobre" ? "page" : undefined}>{copy.about}</a>
    <a href={sectionHref("contato")} aria-current={currentSection === "contato" ? "page" : undefined}>{copy.contact}</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const languageMenu = document.querySelector<HTMLDetailsElement>("[data-language-menu]");

  const updateMenuLabel = () => {
    if (!toggle) return;
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    const label = isOpen ? toggle.getAttribute("data-close-label") : toggle.getAttribute("data-open-label");
    if (label) toggle.setAttribute("aria-label", label);
  };

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    menu?.classList.remove("is-open");
    updateMenuLabel();
  };

  const updateThemeLabel = () => {
    if (!themeToggle) return;
    const isDark = document.documentElement.dataset.theme === "dark";
    const label = isDark ? themeToggle.dataset.lightLabel : themeToggle.dataset.darkLabel;
    if (label) themeToggle.setAttribute("aria-label", label);
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("is-open", !isOpen);
    updateMenuLabel();
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (toggle?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      toggle.focus();
    }
    if (languageMenu?.open) {
      languageMenu.open = false;
      languageMenu.querySelector("summary")?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    if (languageMenu?.open && !languageMenu.contains(event.target as Node)) languageMenu.open = false;
  });

  themeToggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("sharkdive-theme", nextTheme);
    updateThemeLabel();
  });

  updateThemeLabel();
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    border-bottom: 1px solid rgb(255 255 255 / 16%);
    background: rgb(6 46 59 / 96%);
    color: white;
    --focus: var(--focus-on-dark);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    min-height: 78px;
    gap: 28px;
  }

  .brand {
    display: block;
    width: 170px;
    height: 52px;
    overflow: hidden;
  }

  .brand img {
    width: 170px;
    height: auto;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .desktop-nav a {
    color: var(--text-on-dark);
  }

  .desktop-nav a:hover {
    color: white;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .utility-button {
    display: inline-flex;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 4px;
    background: transparent;
    color: white;
    cursor: pointer;
  }

  .utility-button:hover {
    border-color: rgb(255 255 255 / 70%);
    background: rgb(255 255 255 / 9%);
  }

  .language-switch {
    width: 58px;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .language-menu {
    position: relative;
  }

  .language-menu summary {
    list-style: none;
  }

  .language-menu summary::-webkit-details-marker {
    display: none;
  }

  .language-options {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    width: 168px;
    overflow: hidden;
    border: 1px solid var(--border-on-ink);
    border-radius: 4px;
    background: var(--ink);
    box-shadow: 0 16px 36px rgb(0 0 0 / 24%);
  }

  .language-options a {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    color: var(--text-on-dark);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .language-options a:hover,
  .language-options a[aria-current="page"] {
    background: var(--ocean-hover);
    color: white;
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  /* Troca de ícone do tema: override de seletor é obrigatório aqui, é
     display, não cor — token não resolve. */
  .theme-sun {
    display: none;
  }

  html[data-theme="dark"] .theme-moon {
    display: none;
  }

  html[data-theme="dark"] .theme-sun {
    display: block;
  }

  @media (max-width: 940px) {
    .header-inner {
      grid-template-columns: 190px 1fr auto;
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: grid;
      width: 44px;
      height: 44px;
      place-items: center;
      border: 1px solid rgb(255 255 255 / 28%);
      border-radius: 4px;
      background: transparent;
      cursor: pointer;
    }

    .menu-toggle .menu-close-icon {
      display: none;
    }

    .menu-toggle[aria-expanded="true"] .menu-open-icon {
      display: none;
    }

    .menu-toggle[aria-expanded="true"] .menu-close-icon {
      display: block;
    }

    .mobile-nav {
      position: absolute;
      inset: 78px 0 auto;
      display: none;
      border-top: 1px solid var(--border-on-ink);
      background: var(--ink);
      padding: 18px 24px 28px;
    }

    .mobile-nav.is-open {
      display: grid;
    }

    .mobile-nav a {
      border-bottom: 1px solid var(--border-on-ink);
      padding: 14px 0;
      font-weight: 600;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: 70px;
    }

    .brand {
      width: 150px;
      height: 46px;
    }

    .brand img {
      width: 150px;
    }

    .header-actions {
      gap: 5px;
    }

    .utility-button {
      width: 40px;
      height: 40px;
    }

    .language-switch {
      width: 48px;
    }

    .mobile-nav {
      inset-block-start: 70px;
    }
  }

  @media (max-width: 360px) {
    .brand {
      width: 132px;
      height: 41px;
    }

    .brand img {
      width: 132px;
    }

    .utility-button {
      width: 38px;
      height: 38px;
    }

    .language-switch {
      width: 44px;
    }

    .menu-toggle {
      width: 42px;
      height: 42px;
    }
  }
</style>
