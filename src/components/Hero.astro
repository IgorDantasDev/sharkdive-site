---
import { Picture } from "astro:assets";
import { ArrowRight, ChevronDown, MapPin } from "@lucide/astro";
import heroImage from "../assets/acervo/embarcacao-farol.jpg";
import { heroCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { selectCopy } from "../lib/i18n";
import { whatsappUrl } from "../lib/contact";
import { withBase } from "../lib/path";
import { sectionPath } from "../lib/routes";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = selectCopy(lang, heroCopy);
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <Picture
    class="hero-image"
    src={heroImage}
    formats={["avif", "webp"]}
    fallbackFormat="jpeg"
    widths={[640, 1024, 1440, 1920]}
    sizes="100vw"
    alt={copy.imageAlt}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-shade"></div>
  <div class="shell hero-content">
    <p class="hero-kicker"><MapPin size={17} /> Salvador, Bahia</p>
    <h1 id="hero-title">Shark Dive</h1>
    <p class="hero-lead">{copy.lead}</p>
    <div class="hero-actions">
      <a
        class="button button-primary"
        href={whatsappUrl(copy.firstDiveMessage)}
        target="_blank"
        rel="noreferrer"
      >
        {copy.firstDiveCta}
        <ArrowRight size={18} />
      </a>
      <a class="button button-light" href={withBase(sectionPath(lang, "cursos"))}>{copy.coursesCta}</a>
    </div>
  </div>
  <a class="hero-scroll" href={withBase(sectionPath(lang, "batismo"))} aria-label={copy.servicesLabel}>
    <span>{copy.explore}</span>
    <ChevronDown size={20} />
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: min(82vh, 780px);
    align-items: center;
    overflow: hidden;
    padding-top: 78px;
    color: white;
    background: var(--abyss);
    --focus: var(--focus-on-dark);
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    object-fit: cover;
    object-position: center 52%;
  }

  .hero-shade {
    background: rgb(0 47 64 / 44%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-block: 110px 130px;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 0.84rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 820px;
    margin-bottom: 14px;
    font-size: clamp(5rem, 12vw, 10.5rem);
    text-shadow: 0 2px 28px rgb(0 0 0 / 24%);
  }

  .hero-lead {
    max-width: 660px;
    margin-bottom: 32px;
    font-size: clamp(1.18rem, 2.2vw, 1.65rem);
    line-height: 1.45;
    text-shadow: 0 2px 16px rgb(0 0 0 / 42%);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-scroll {
    position: absolute;
    z-index: 2;
    right: 32px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: min(690px, 100svh);
      padding-top: 70px;
    }

    .hero-image {
      object-position: 60% center;
    }

    .hero-shade {
      background: rgb(0 39 54 / 54%);
    }

    .hero-content {
      align-self: end;
      padding-block: 96px 82px;
    }

    .hero h1 {
      font-size: 4.15rem;
    }

    .hero-lead {
      max-width: 440px;
      font-size: 1.16rem;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero-scroll {
      display: none;
    }
  }
</style>
