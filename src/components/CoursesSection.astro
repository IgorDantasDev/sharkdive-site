---
import { Picture } from "astro:assets";
import { ChevronDown } from "@lucide/astro";
import mergulhoTecnicoVega from "../assets/acervo/mergulho-tecnico-vega.jpg";
import { courseGroupCopy, coursesCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { selectCopy } from "../lib/i18n";
import { whatsappUrl } from "../lib/contact";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = selectCopy(lang, coursesCopy);
const courseGroups = courseGroupCopy.map(({ copy: groupCopy, courses }) => ({
  ...selectCopy(lang, groupCopy),
  courses,
}));
---

<section class="section courses" id="cursos">
  <div class="shell">
    <div class="courses-intro">
      <div class="section-heading">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
      </div>
      <p>
        {copy.introduction}
      </p>
    </div>

    <figure class="section-media courses-media">
      <div class="media-crop media-crop-detail">
        <Picture
          src={mergulhoTecnicoVega}
          formats={["avif", "webp"]}
          fallbackFormat="jpeg"
          widths={[640, 1024, 1440]}
          sizes="(max-width: 940px) 100vw, 60vw"
          alt={copy.imageAlt}
          loading="lazy"
        />
      </div>
      <figcaption>{copy.caption}</figcaption>
    </figure>

    <div class="course-list">
      {courseGroups.map((group, index) => (
        <details class="course-group" open={index === 0}>
          <summary>
            <span class="course-number">0{index + 1}</span>
            <span class="course-summary-copy">
              <small>{group.eyebrow}</small>
              <strong>{group.title}</strong>
            </span>
            <span class="course-description">{group.description}</span>
            <ChevronDown class="course-chevron" size={22} />
          </summary>
          <div class="course-body">
            {group.courses.map((course) => <span>{course}</span>)}
          </div>
        </details>
      ))}
    </div>

    <div class="career-band">
      <div>
        <p class="eyebrow">{copy.careerEyebrow}</p>
        <h3>{copy.careerTitle}</h3>
      </div>
      <div class="career-levels" aria-label={copy.careerLabel}>
        <span>Divemaster SDI</span>
        <span>Assistant Instructor</span>
        <span>Open Water Scuba Diver Instructor</span>
      </div>
      <a
        class="button button-dark"
        href={whatsappUrl(copy.careerMessage)}
        target="_blank"
        rel="noreferrer"
      >{copy.careerCta}</a>
    </div>
  </div>
</section>

<style>
  .courses {
    background: var(--soft);
  }

  .courses-intro {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: end;
    gap: 90px;
    margin-bottom: 56px;
  }

  .courses-media {
    margin-top: 0;
    margin-bottom: 64px;
  }

  .courses-intro h2 {
    margin-bottom: 0;
  }

  .courses-intro > p {
    margin-bottom: 8px;
    color: var(--muted);
  }

  .course-list {
    border-top: 1px solid var(--line);
  }

  .course-group {
    border-bottom: 1px solid var(--line);
  }

  .course-group summary {
    display: grid;
    grid-template-columns: 52px minmax(190px, 0.75fr) 1fr 24px;
    align-items: center;
    gap: 24px;
    min-height: 112px;
    cursor: pointer;
    list-style: none;
  }

  .course-group summary::-webkit-details-marker {
    display: none;
  }

  .course-number {
    color: var(--teal);
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .course-summary-copy {
    display: grid;
  }

  .course-summary-copy small {
    color: var(--muted);
    font-size: 0.69rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .course-summary-copy strong {
    font-family: var(--display);
    font-size: 1.55rem;
  }

  .course-description {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .course-chevron {
    transition: transform 180ms ease;
  }

  .course-group[open] .course-chevron {
    transform: rotate(180deg);
  }

  .course-body {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 48px 28px 76px;
  }

  .course-body span {
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper);
    padding: 8px 12px;
    font-size: 0.81rem;
    font-weight: 600;
  }

  .career-band {
    display: grid;
    grid-template-columns: 1fr 1.2fr auto;
    align-items: center;
    gap: 36px;
    margin-top: 72px;
    border-left: 5px solid var(--red);
    background: var(--paper);
    padding: 34px 36px;
  }

  .career-band .eyebrow {
    margin-bottom: 8px;
  }

  .career-band h3 {
    margin-bottom: 0;
    font-size: 2rem;
  }

  .career-levels {
    display: grid;
    gap: 5px;
    color: var(--muted);
    font-size: 0.86rem;
  }

  /* Único override de tema realmente necessário aqui: no escuro estas duas
     superfícies não são --paper, e sim um tom acima dele. */
  html[data-theme="dark"] .course-body span,
  html[data-theme="dark"] .career-band {
    background: var(--course-surface);
  }

  @media (max-width: 940px) {
    .courses-intro {
      grid-template-columns: 1fr;
      gap: 42px;
    }

    .career-band {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .courses-intro {
      gap: 28px;
      margin-bottom: 40px;
    }

    .courses-media {
      margin-top: 0;
      margin-bottom: 40px;
    }

    .course-group summary {
      grid-template-columns: 36px 1fr 24px;
      gap: 10px;
      min-height: 98px;
    }

    .course-description {
      display: none;
    }

    .course-summary-copy strong {
      font-size: 1.3rem;
    }

    .course-body {
      display: grid;
      padding: 0 0 24px 46px;
    }

    .career-band {
      margin-top: 40px;
      padding: 28px 24px;
    }
  }
</style>
