---
import { Picture } from "astro:assets";
import { Anchor, ArrowRight, ShieldCheck, WavesLadder } from "@lucide/astro";
import batismoEmbarcacao from "../assets/acervo/batismo-embarcacao.jpg";
import { recreationalCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { selectCopy } from "../lib/i18n";
import { whatsappUrl } from "../lib/contact";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = selectCopy(lang, recreationalCopy);
---

<section class="section recreational" id="mergulho-recreativo">
  <div class="shell split-layout">
    <div class="section-heading">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
    </div>
    <div class="section-copy">
      <p class="lead-copy">
        {copy.lead}
      </p>
      <div class="feature-list">
        <article>
          <Anchor size={24} />
          <div>
            <h3>{copy.beginnerTitle}</h3>
            <p>{copy.beginnerDescription}</p>
          </div>
        </article>
        <article>
          <WavesLadder size={24} />
          <div>
            <h3>{copy.guidanceTitle}</h3>
            <p>{copy.guidanceDescription}</p>
          </div>
        </article>
        <article>
          <ShieldCheck size={24} />
          <div>
            <h3>{copy.supervisionTitle}</h3>
            <p>{copy.supervisionDescription}</p>
          </div>
        </article>
      </div>
      <a
        class="text-link"
        href={whatsappUrl(copy.message)}
        target="_blank"
        rel="noreferrer"
      >{copy.cta} <ArrowRight size={17} /></a>
    </div>
  </div>
  <figure class="shell section-media recreational-media">
    <div class="media-crop media-crop-detail">
      <Picture
        src={batismoEmbarcacao}
        formats={["avif", "webp"]}
        fallbackFormat="jpeg"
        widths={[640, 1024, 1440]}
        sizes="(max-width: 940px) 100vw, 60vw"
        alt={copy.imageAlt}
        loading="lazy"
      />
    </div>
    <figcaption>{copy.caption}</figcaption>
  </figure>
</section>

<style>
  .feature-list {
    border-top: 1px solid var(--line);
  }

  .feature-list article {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 16px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
  }

  .feature-list svg {
    margin-top: 3px;
    color: var(--teal);
  }

  .feature-list h3 {
    margin-bottom: 8px;
    font-size: 1.4rem;
  }

  .feature-list p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
