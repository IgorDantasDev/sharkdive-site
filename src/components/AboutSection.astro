---
import type { Locale } from "../lib/i18n";
import { translate } from "../lib/i18n";
import { withBase } from "../lib/path";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = (pt: string, en: string) => translate(lang, pt, en);
---

<section class="section about" id="sobre">
  <div class="shell about-grid">
    <div class="about-mark" aria-hidden="true">
      <img
        src={withBase("/images/brand/sharkdive-logo-black.png")}
        width="1999"
        height="787"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      <p class="eyebrow">{t("Sobre nós", "About us")}</p>
      <h2>{t("Uma equipe preparada para receber você.", "A team ready to welcome you.")}</h2>
      <p class="lead-copy">
        {t(
          "Somos uma equipe especializada, formada por instrutores em todos os níveis, divemasters experientes e profissionais de marinharia treinados e em sintonia com cada mergulho.",
          "We are a specialized team of instructors at every level, experienced divemasters and trained boat crew working in sync with every dive.",
        )}
      </p>
      <p class="about-detail">
        {t(
          "Nossa atuação atual está concentrada em batismos de mergulho, formação de mergulhadores e safaris para observação de baleias.",
          "Our current activities focus on first-time scuba experiences, diver training and whale-watching safaris.",
        )}
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--water);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: 110px;
  }

  .about-mark {
    display: flex;
    min-height: 320px;
    align-items: center;
    border: 1px solid var(--line);
    background: white;
    padding: 28px;
  }

  .about-mark img {
    width: 100%;
    height: auto;
    clip-path: inset(0 0 24% 0);
  }

  .about h2 {
    font-size: clamp(2.6rem, 5.3vw, 4.8rem);
  }

  .about-detail {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }

  @media (max-width: 940px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }
  }

  @media (max-width: 640px) {
    .about-grid {
      gap: 32px;
    }

    .about-mark {
      min-height: 230px;
    }
  }
</style>
