---
import { aboutCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { selectCopy } from "../lib/i18n";
import { withBase } from "../lib/path";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = selectCopy(lang, aboutCopy);
---

<section class="section about" id="sobre">
  <div class="shell about-grid">
    <div class="about-mark" aria-hidden="true">
      <img
        src={withBase("/images/brand/sharkdive-logo-black.png")}
        width="1999"
        height="787"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p class="lead-copy">
        {copy.lead}
      </p>
      <p class="about-detail">
        {copy.detail}
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--water);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: 110px;
  }

  .about-mark {
    display: flex;
    min-height: 320px;
    align-items: center;
    border: 1px solid var(--line);
    background: white;
    padding: 28px;
  }

  .about-mark img {
    width: 100%;
    height: auto;
    clip-path: inset(0 0 24% 0);
  }

  .about h2 {
    font-size: clamp(2.6rem, 5.3vw, 4.8rem);
  }

  .about-detail {
    margin-bottom: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }

  @media (max-width: 940px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 42px;
    }
  }

  @media (max-width: 640px) {
    .about-grid {
      gap: 32px;
    }

    .about-mark {
      min-height: 230px;
    }
  }
</style>
