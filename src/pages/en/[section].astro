---
import LandingPage from "../../components/LandingPage.astro";
import { getSectionStaticPaths, type SectionRoute } from "../../lib/routes";

export const getStaticPaths = () => getSectionStaticPaths("en");

interface Props {
  section: SectionRoute;
}

const { section } = Astro.props as Props;
---

<LandingPage lang="en" initialSection={section} />
