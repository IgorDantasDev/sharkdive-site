---
import { getImage } from "astro:assets";
import socialSource from "../assets/acervo/embarcacao-farol.jpg";
import { layoutCopy } from "../content/site";
import type { Locale } from "../lib/i18n";
import { localeSettings, selectCopy } from "../lib/i18n";
import { withBase } from "../lib/path";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: Locale;
  image?: string;
  canonicalPath?: string;
  alternatePtPath?: string;
  alternateEnPath?: string;
  alternateEsPath?: string;
}

const {
  title,
  description,
  lang = "pt",
  image,
  canonicalPath = localeSettings[lang].rootPath,
  alternatePtPath = "/",
  alternateEnPath = "/en/",
  alternateEsPath = "/es/",
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const locale = localeSettings[lang];
const copy = selectCopy(lang, layoutCopy);

// Crawlers sociais exigem URL absoluta e não leem srcset — imagem única em 1.91:1.
const socialImage = await getImage({
  src: socialSource,
  width: 1200,
  height: 630,
  format: "jpeg",
});
const socialImageUrl = new URL(image ?? socialImage.src, Astro.site);
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#101416" />
    <link
      rel="preload"
      href={withBase("/fonts/inter-var-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("/fonts/barlow-condensed-700-latin.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/sharkdive-mark-transparent-32.png")} />
    <link rel="icon" type="image/png" sizes="512x512" href={withBase("/sharkdive-mark-transparent-512.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/sharkdive-mark-transparent-180.png")} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(alternatePtPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(alternateEnPath, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(alternateEsPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(alternatePtPath, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shark Dive" />
    <meta property="og:locale" content={locale.openGraphLocale} />
    {lang !== "pt" && <meta property="og:locale:alternate" content="pt_BR" />}
    {lang !== "en" && <meta property="og:locale:alternate" content="en_US" />}
    {lang !== "es" && <meta property="og:locale:alternate" content="es_ES" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={copy.socialImageAlt} />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("sharkdive-theme");
        const preferredTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme = savedTheme || preferredTheme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{copy.skipToContent}</a>
    <slot />
  </body>
</html>
